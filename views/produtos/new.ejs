<!doctype html>
<html lang="pt-br">

<%- include("includes/headers"); %>

    <body>
        <%- include("includes/navbar"); %>

            <div class="container">
                <h1>Novo Produto</h1>

                <form action="/produtos/salvar" method="POST">
                    <div class="mb-3">
                        <label for="referencia" class="form-label">Referência</label>
                        <input type="text" class="form-control" id="referencia" name="referencia" maxlength="100"
                            required>
                    </div>

                    <div class="mb-3">
                        <label for="descricao" class="form-label">Descrição</label>
                        <input type="descricao" class="form-control" id="descricao" name="descricao" maxlength="200">
                    </div>

                    <div class="mb-3">
                        <label for="preco" class="form-label">Preço</label>
                        <input type="preco" class="form-control" id="preco" name="preco" maxlength="20"
                            inputmode="numeric" autocomplete="preco">
                    </div>
                    <script>
                        const precoInput = document.getElementById('preco');

                        precoInput.addEventListener('input', (event) => {
                            event.target.value = event.target.value.replace(/\D/g, '');
                        });
                    </script>

                    <div class="mb-3">
                        <label for="estoque" class="form-label">Estoque</label>
                        <input type="estoque" class="form-control" id="estoque" name="estoque" maxlength="20">
                    </div>

                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a href="/produtos" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>

            <%- include("includes/footer"); %>
    </body>

</html>