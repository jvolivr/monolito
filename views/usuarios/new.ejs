<!doctype html>
<html lang="pt-br">

<%- include("includes/headers"); %>

    <body>
        <%- include("includes/navbar"); %>

            <div class="container">
                <h1>Novo Usuário</h1>

                <form action="/usuarios/salvar" method="POST">
                    <div class="mb-3">
                        <label for="nome" class="form-label">Nome</label>
                        <input type="text" class="form-control" id="nome" name="nome" maxlength="100" required>
                    </div>

                    <div class="mb-3">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" name="email" maxlength="200">
                    </div>

                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha</label>
<!-- Se falar que foi IA eu nego kk -->
                        <div class="position-relative">
                            <input type="password" class="form-control" id="senha" placeholder="••••••••" required
                                name="senha" maxlength="64">
                            <button type="button" class="password-toggle"
                                onclick="togglePassword('senha', this)">👁️</button>
                        </div>
                        <script>
                            function togglePassword(inputId, button) {
                                const input = document.getElementById(inputId);

                                if (input.type === "password") {
                                    input.type = "text";
                                    button.textContent = "🚫";
                                } else {
                                    input.type = "password";
                                    button.textContent = "👁️"; 
                                }
                            }
                        </script>
                    </div>

                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
                </form>
            </div>

            <%- include("includes/footer"); %>
    </body>

</html>