<!doctype html>
<html lang="pt-br">

<%- include("includes/headers"); %>

    <body>
        <%- include("includes/navbar"); %>

            <% const usuario=locals.usuario || { id: locals.usuarioId }; %>

                <div class="container">
                    <h1>Editar usuário <%= usuario.id %>
                    </h1>

                    <form action="/usuarios/atualizar" method="POST">
                        <input type="hidden" name="id" value="<%= usuario.id %>">

                        <div class="mb-3">
                            <label for="nome" class="form-label">Nome</label>
                            <input type="text" class="form-control" id="nome" name="nome" maxlength="100"
                                value="<%= usuario.nome || '' %>" required>
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" maxlength="200"
                                value="<%= usuario.email || '' %>">
                        </div>

                        <div class="mb-3">
                            <label for="senha" class="form-label">Senha</label>
                            <input type="password" class="form-control" id="senha" placeholder="••••••••" required name="senha" maxlength="64"
                                value="<%= usuario.senha || '' %>">
                                <button type="button" class="password-toggle"
                                    onclick="togglePassword('senha', this)">👁️</button>
                        </div>

                         <script>
                            function togglePassword(inputId, button) {
                                const input = document.getElementById(inputId);

                                if (input.type === "password") {
                                    input.type = "text";
                                    button.textContent = "🚫";
                                } else {
                                    input.type = "password";
                                    button.textContent = "👁️"; 
                                }
                            }
                        </script>

                        <button type="submit" class="btn btn-primary">Atualizar</button>
                        <a href="/usuarios" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>

                <%- include("includes/footer"); %>
    </body>

</html>